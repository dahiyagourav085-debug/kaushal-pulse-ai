# KAUSHAL PULSE AI — Environment Configuration Example

# Port for the Node/Express server (Render automatically provides process.env.PORT)
PORT=3000

# Server environment ('production' for live deployment, 'development' for local Vite HMR)
NODE_ENV=production

# Optional Gemini API Key for AI Copilot
# If omitted or unavailable, Copilot automatically uses grounded deterministic intelligence.
# GEMINI_API_KEY=
